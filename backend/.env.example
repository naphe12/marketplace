# Copier vers backend/.env en local, ou définir ces variables chez l'hébergeur.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
# Remplacer par une clé aléatoire : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET

# Bucket privé Railway (optionnel tant que seules des URLs externes sont utilisées)
PUBLIC_API_URL=http://127.0.0.1:8000
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
S3_REGION=auto


# Paiements réels
# Si ces deux variables sont renseignées, le checkout appelle POST {PAYMENT_PROVIDER_BASE_URL}/payments
# avec Authorization: Bearer {PAYMENT_PROVIDER_API_KEY}. Le provider doit rappeler
# POST {PUBLIC_API_URL}/api/v1/billing/webhooks/provider avec une signature HMAC SHA-256
# dans l'en-tête X-Signature si PAYMENT_PROVIDER_WEBHOOK_SECRET est défini.
SIMULATED_PAYMENTS_ENABLED=false
# PAYMENT_PROVIDER_BASE_URL=https://provider.example.com
# PAYMENT_PROVIDER_API_KEY=REPLACE_WITH_PROVIDER_KEY
# PAYMENT_PROVIDER_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
# Option multi-pays: surcharge par pays actif admin. Les clés manquantes retombent sur les variables globales.
# PAYMENT_PROVIDER_BY_COUNTRY={"BI":{"provider":"LUMICASH","base_url":"https://pay-bi.example.com","api_key":"KEY","webhook_secret":"SECRET"},"RW":{"provider":"MTN_MOMO","base_url":"https://pay-rw.example.com","api_key":"KEY"}}

# SMS réels
# Le backend appelle POST {SMS_PROVIDER_BASE_URL}/messages avec Authorization Bearer.
# Utilisé pour réinitialisation mot de passe et vérification téléphone.
# SMS_PROVIDER_BASE_URL=https://sms.example.com
# SMS_PROVIDER_API_KEY=REPLACE_WITH_SMS_KEY
# SMS_PROVIDER_BY_COUNTRY={"BI":{"base_url":"https://sms-bi.example.com","api_key":"KEY","sender":"MarketBI"},"RW":{"base_url":"https://sms-rw.example.com","api_key":"KEY","sender":"MarketRW"}}
SMS_SENDER_NAME=Marketplace
PASSWORD_RESET_TOKEN_MINUTES=15
